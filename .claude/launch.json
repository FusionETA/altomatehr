{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--launch-profile", "http"],
      "cwd": "backend",
      "port": 5001
    },
    {
      "name": "backend-local-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ConnectionStrings__Default=Server=localhost;Port=3306;Database=altomatehr_local;User=root;Password=;AllowPublicKeyRetrieval=True;SslMode=None",
        "Seed__DemoData=true",
        "EngineMailer__ApiKey=",
        "dotnet", "run", "--launch-profile", "http"
      ],
      "cwd": "backend",
      "port": 5001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 5173
    }
  ]
}
