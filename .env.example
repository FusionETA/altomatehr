# ---- Public domain (Caddy TLS) ----
DOMAIN=app.yourdomain.com

# ---- Database (DigitalOcean Managed MySQL — SSL required) ----
# Double-underscore maps to the ConnectionStrings:Default config key.
ConnectionStrings__Default=Server=YOUR-DB-HOST;Port=25060;Database=altomatehr;User=doadmin;Password=YOUR-DB-PASSWORD;SslMode=Required

# ---- JWT signing (generate once: openssl rand -base64 48) ----
Jwt__Key=CHANGE-ME-long-random-secret
Jwt__Issuer=altomatehr-api
Jwt__Audience=altomatehr-client
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# ---- Superadmin (Fusioneta internal staff, comma-separated) ----
SUPERADMIN_EMAILS=you@fusioneta.com

# ---- Xero (if used) ----
# RedirectUri is REQUIRED alongside the id/secret — XeroClient refuses to build
# an authorization URL without all three.
Xero__ClientId=
Xero__ClientSecret=
Xero__RedirectUri=

# ---- Gemini (receipt OCR) ----
# Google AI Studio key. Leave blank to disable OCR — the endpoint then returns
# 503 with a clear message rather than failing obscurely.
Gemini__ApiKey=
# Override only; defaults to gemini-2.5-flash in appsettings.json. Google retires
# models (1.5-flash now 404s), so this is tunable without a redeploy.
Gemini__Model=

# ---- EngineMailer (transactional email) ----
# Leave ApiKey blank in dev: the app falls back to a logging sender that writes
# the email (including the reset code) to the server log instead of sending.
#
# WARNING: keep exactly ONE definition of this key. A duplicate blank entry later
# in the file silently overrides a real one and takes out all outbound mail.
EngineMailer__ApiKey=
# Must be a VERIFIED sender on EngineMailer's side or every send is rejected.
EngineMailer__FromEmail=
EngineMailer__FromName=AltomateHR
